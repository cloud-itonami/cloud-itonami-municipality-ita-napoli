(ns ordinance.facts-test
  (:require [clojure.edn :as edn]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is]]
            [ordinance.facts :as facts]))

(deftest napoli-has-spec-basis
  (let [sb (facts/spec-basis "napoli")]
    (is (= 2 (count sb)))
    (is (every? #(str/starts-with? (:ordinance/url %) "https://static-www.comune.napoli.it/") sb))))

(deftest unknown-municipality-has-no-spec-basis
  (is (nil? (facts/spec-basis "roma")))
  (is (nil? (facts/spec-basis "zzz"))))

(deftest coverage-is-honest
  (let [c (facts/coverage ["napoli" "roma"])]
    (is (= 2 (:requested c)))
    (is (= 1 (:covered c)))
    (is (= ["roma"] (:missing-municipalities c)))))

(deftest by-topic-filters
  (is (= ["napoli.regolamento-toponomastica-numerazione-civica-2021"]
         (mapv :ordinance/id (facts/by-topic "napoli" :toponymy))))
  (is (empty? (facts/by-topic "napoli" :labor)))
  (is (empty? (facts/by-topic "roma" :transparency))))

(deftest tx-file-matches-catalog
  (let [tx (edn/read-string (slurp "data/datascript-tx.edn"))
        flat (mapcat val (sort-by key facts/catalog))]
    (is (= (vec flat) (vec tx)))))
